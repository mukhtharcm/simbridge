{
  "name": "Snapdragon 695 (holi), WCD937x",
  "platforms": ["holi"],
  "note": "Verified on: Moto g45 5G (fogos), LineageOS 24. Mixer commands from gsm2sip's SM6150 profile (MIT, pulpoff).",

  "speakerRoute": true,
  "routeChangeDelayMs": 500,
  "routeSettleDelayMs": 500,

  "halCallVsids": ["11c05000", "11dc5000"],
  "incallMusicParam": "incall_music_enabled",

  "playbackStereo": true,
  "playbackBufferMs": 100,

  "mixerSetup": [
    "'Voice Rx Device Mute' 0 4294967295 20",
    "'Voice Tx Mute' 0 4294967295 20",
    "'Voice Tx Device Mute' 1 4294967295 20",
    "'Incall_Music Audio Mixer MultiMedia1' 1",
    "'Incall_Music Audio Mixer MultiMedia2' 1",
    "'Incall_Music Audio Mixer MultiMedia5' 1",
    "'Incall_Music Audio Mixer MultiMedia9' 1",
    "'Voc Rec Config' 2",
    "'MultiMedia1 Mixer VOC_REC_DL' 1",
    "'MultiMedia1 Mixer VOC_REC_UL' 0",
    "'MultiMedia4 Mixer VOC_REC_DL' 1",
    "'MultiMedia4 Mixer VOC_REC_UL' 0",
    "'MultiMedia8 Mixer VOC_REC_DL' 1",
    "'MultiMedia8 Mixer VOC_REC_UL' 0",
    "'MultiMedia9 Mixer VOC_REC_DL' 1",
    "'MultiMedia9 Mixer VOC_REC_UL' 0"
  ],
  "mixerAfterPlayback": [
    "'Incall_Music Audio Mixer MultiMedia1' 1",
    "'Incall_Music Audio Mixer MultiMedia2' 1",
    "'Incall_Music Audio Mixer MultiMedia5' 1",
    "'Incall_Music Audio Mixer MultiMedia9' 1",
    "'Voice Tx Mute' 0 4294967295 20",
    "'Voice Tx Device Mute' 1 4294967295 20"
  ],
  "mixerAfterCapture": [
    "'Voice Rx Device Mute' 1 4294967295 20",
    "'Voice Tx Device Mute' 1 4294967295 20",
    "'ADC1 Volume' 0",
    "'ADC2 Volume' 0",
    "'ADC3 Volume' 0",
    "'MultiMedia9 Mixer VOC_REC_UL' 0",
    "'MultiMedia1 Mixer VOC_REC_UL' 0"
  ],
  "mixerRestore": [
    "'Voice Rx Device Mute' 0 4294967295 20",
    "'Voice Tx Device Mute' 0 4294967295 20",
    "'Voice Tx Mute' 0 4294967295 20",
    "'Voc Rec Config' 1",
    "'ADC1 Volume' 12",
    "'ADC2 Volume' 12",
    "'ADC3 Volume' 12",
    "'Incall_Music Audio Mixer MultiMedia1' 0",
    "'Incall_Music Audio Mixer MultiMedia2' 0",
    "'Incall_Music Audio Mixer MultiMedia5' 0",
    "'Incall_Music Audio Mixer MultiMedia9' 0",
    "'MultiMedia1 Mixer VOC_REC_DL' 0",
    "'MultiMedia4 Mixer VOC_REC_DL' 0",
    "'MultiMedia8 Mixer VOC_REC_DL' 0",
    "'MultiMedia9 Mixer VOC_REC_DL' 0"
  ]
}
